rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Phase 1 & 3: Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Allow access to all subcollections (period_logs, symptom_logs, etc)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Phase 1 & 3: Doctors collection
    match /doctors/{doctorId} {
      allow read: if true; // Publicly readable profiles
      allow write: if isAuthenticated(); // Allow any authenticated user to write for seeding purposes
    }

    // Phase 1 & 3: Bookings collection
    match /bookings/{bookingId} {
      // Temporarily allow all read/write for testing without Authentication
      allow read, write: if true; 
    }

    // Real-Time Chat Engine
    match /chats/{chatId} {
      // Temporarily allow all read/write for testing without Authentication
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Phase 1 & 3: Whisper Room posts
    match /whisper_posts/{postId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == request.resource.data.authorId;
    }
    
    // Phase 3: Learn Content (Pink Corner Articles)
    match /articles/{articleId} {
      allow read: if true; // Publicly readable educational articles
      allow write: if isAuthenticated(); // Allow seeding
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
