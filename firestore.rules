rules_version = '2';

// Firestore Security Rules for SYNCO (herSync)
//
// Every user document and every period log lives under /users/{uid}.
// A user can ONLY read or write their own document and subcollection.
// Unauthenticated requests are rejected entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // User profiles
    // users/{uid} mirrors the Supabase `profiles` table.
    // The document id is always the Firebase Authentication user id.
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // -----------------------------------------------------------------
      // Period logs
      // users/{uid}/period_logs/{logId} mirrors the Supabase
      // `period_logs` table. Scoped to the same owning user.
      // -----------------------------------------------------------------
      match /period_logs/{logId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.user_id == request.auth.uid;
        allow update: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.user_id == request.auth.uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}