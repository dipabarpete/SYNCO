rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Phase 1 & 3: Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /notifications/{notificationId} {
        allow write: if isAuthenticated();
      }
      
      
      // Allow access to all subcollections (period_logs, symptom_logs, etc)
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Phase 1 & 3: Doctors collection
    match /doctors/{doctorId} {
      allow read: if true; // Publicly readable profiles
      allow write: if isOwner(doctorId); // Only the doctor can edit their own profile

      // Reviews subcollection
      match /reviews/{reviewId} {
        // Anyone can read reviews (publicly visible on doctor profile)
        allow read: if true;
        // An authenticated patient can create a review; patientId must match their uid
        allow create: if isAuthenticated() &&
          request.resource.data.patientId == request.auth.uid;
        // Only the review author can update or delete their own review
        allow update, delete: if isAuthenticated() &&
          resource.data.patientId == request.auth.uid;
      }
    }

    // Phase 1 & 3: Bookings collection
    match /bookings/{bookingId} {
      // Patient (stored as 'userId') or doctor can read their own bookings.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.doctorId
      );
      // A patient can create a booking for themselves.
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
      // A patient or doctor can update/delete their own booking.
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.doctorId
      );
    }

    // Real-Time Chat Engine
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Phase 1 & 3: Whisper Room posts
    match /whisper_posts/{postId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == request.resource.data.authorId ||
        (request.resource.data.isAnonymous == true && request.resource.data.authorId == '')
      );
    }

    // Phase 2: UGC Moderation - Reported Posts
    match /reported_posts/{reportId} {
      // Users can only create a report, not read the queue (that's for admins)
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false; 
    }

    // Phase 2: UGC Moderation - Blocked Users
    match /users/{userId}/blocked_users/{blockedId} {
      // Users can manage their own blocked list
      allow read, write: if isOwner(userId);
    }
    
    // Phase 3: Learn Content (Pink Corner Articles)
    match /articles/{articleId} {
      allow read: if true; // Publicly readable educational articles
      allow write: if false; // Only admin (via Admin SDK/Vercel) can write
    }

    match /learn_content/{docId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
