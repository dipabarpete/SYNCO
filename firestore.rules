rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Phase 1 & 3: Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /notifications/{notificationId} {
        allow write: if isAuthenticated();
      }
      
      
      // Allow access to all subcollections (period_logs, symptom_logs, etc)
      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Phase 1 & 3: Doctors collection
    match /doctors/{doctorId} {
      allow read: if true; // Publicly readable profiles
      allow create, delete: if isOwner(doctorId); // Only the doctor can create/remove their own profile
      // Doctors can edit their own profile. Patients may only bump the rating
      // fields, which happens transactionally when a review is submitted.
      allow update: if isOwner(doctorId) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'ratingSum', 'reviewCount']) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.ratingSum is number &&
        request.resource.data.ratingSum >= 1 &&
        request.resource.data.reviewCount is int &&
        request.resource.data.reviewCount >= 1
      );

      // Doctor reviews, one per consultation (the document ID is the
      // consultation ID), creatable only after the consultation is completed
      // by the same patient with this doctor.
      match /reviews/{consultationId} {
        allow read: if true; // Publicly visible with the doctor's profile
        allow create: if isAuthenticated() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.doctorId == doctorId &&
          request.resource.data.consultationId == consultationId &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          !exists(/databases/$(database)/documents/doctors/$(doctorId)/reviews/$(consultationId)) &&
          exists(/databases/$(database)/documents/bookings/$(consultationId)) &&
          get(/databases/$(database)/documents/bookings/$(consultationId)).data.status == 'completed' &&
          get(/databases/$(database)/documents/bookings/$(consultationId)).data.userId == request.auth.uid &&
          get(/databases/$(database)/documents/bookings/$(consultationId)).data.doctorId == doctorId;
        allow update, delete: if false;
      }
    }

    // Phase 1 & 3: Bookings collection
    match /bookings/{bookingId} {
      // Patient (stored as 'userId') or doctor can read their own bookings.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.doctorId
      );
      // A patient can create a booking for themselves.
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId;
      // A patient or doctor can update/delete their own booking.
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.doctorId
      );
    }

    // Real-Time Chat Engine
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Phase 1 & 3: Whisper Room posts
    match /whisper_posts/{postId} {
      // Any authenticated user can read the feed.
      allow read: if isAuthenticated();

      // Any authenticated user can create a post as themselves.
      // The server forces authorId = request.auth.uid (see WhisperService.createPost).
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid;

      // The author may update their own post (edit title/content, etc).
      // Any other authenticated user may only interact with a post
      // (like / save / comment / vote) WITHOUT changing owner-controlled fields.
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        (
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.content == resource.data.content &&
          request.resource.data.category == resource.data.category &&
          request.resource.data.isAnonymous == resource.data.isAnonymous
        )
      );

      // Only the author can delete their own post.
      allow delete: if isAuthenticated() &&
        resource.data.authorId == request.auth.uid;
    }

    // Phase 2: UGC Moderation - Reported Posts
    match /reported_posts/{reportId} {
      // Users can only create a report, not read the queue (that's for admins)
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false; 
    }

    // Phase 2: UGC Moderation - Blocked Users
    match /users/{userId}/blocked_users/{blockedId} {
      // Users can manage their own blocked list
      allow read, write: if isOwner(userId);
    }
    
    // Phase 3: Learn Content (Pink Corner Articles)
    match /articles/{articleId} {
      allow read: if true; // Publicly readable educational articles
      allow write: if false; // Only admin (via Admin SDK/Vercel) can write
    }

    match /learn_content/{docId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to seed
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
